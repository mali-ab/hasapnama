@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using HasapNama.App.Services

@layout MainLayout
@page "/login"

<PageTitle>Sign in - HasapNama</PageTitle>

<AuthorizeView>
	<Authorized>
		<p>You are already signed in as <strong>@context.User.Identity?.Name</strong>.</p>
		<a class="btn btn-primary" href="/customers">Open my customers</a>
	</Authorized>
	<NotAuthorized>
		<div class="card mx-auto" style="max-width: 420px;">
			<div class="card-header bg-primary text-white">
				<strong>HasapNama</strong>
				<span class="float-end small">Shared CRM</span>
			</div>
			<div class="card-body">
				<h5 class="card-title">Sign in</h5>
				<EditForm Model="@model" OnValidSubmit="SignInAsync" FormName="login">
					<DataAnnotationsValidator />
					<div class="mb-3">
						<label class="form-label">Username</label>
						<InputText @bind-Value="model.Username" class="form-control" autocomplete="username" />
						<ValidationMessage For="() => model.Username" />
					</div>
					<div class="mb-3">
						<label class="form-label">Password</label>
						<InputText @bind-Value="model.Password" class="form-control" type="password" autocomplete="current-password" />
						<ValidationMessage For="() => model.Password" />
					</div>

					@if (!string.IsNullOrEmpty(error))
					{
						<div class="alert alert-danger py-2">@error</div>
					}

					<div class="d-flex justify-content-between align-items-center">
						<button type="submit" class="btn btn-primary" disabled="@busy">@(busy ? "Signing in..." : "Sign in")</button>
						<a href="/register" class="btn btn-link">Register</a>
					</div>
				</EditForm>
			</div>
		</div>
	</NotAuthorized>
</AuthorizeView>

@code {
	private readonly LoginModel model = new();
	private string? error;
	private bool busy;

	[Inject] private AuthService Auth { get; set; } = default!;

	private async Task SignInAsync()
	{
		busy = true;
		error = null;
		try
		{
			await Auth.SignInAsync(model.Username, model.Password);
			Nav.NavigateTo("/customers", forceLoad: false);
		}
		catch (ApiException ex)
		{
			error = ex.Message;
		}
		catch (Exception ex)
		{
			error = "Could not reach the server: " + ex.Message;
		}
		finally
		{
			busy = false;
		}
	}

	[Inject] private NavigationManager Nav { get; set; } = default!;
}

// Local model so LoginRequest (which has no validation attributes) stays clean.
public class LoginModel
{
	[Required(ErrorMessage = "Enter your username.")]
	public string Username { get; set; } = string.Empty;

	[Required(ErrorMessage = "Enter your password.")]
	public string Password { get; set; } = string.Empty;
}