@page "/customers"
@using Microsoft.AspNetCore.Components.Forms
@using HasapNama.App.Services
@using HasapNama.Shared.Models
@implements IAsyncDisposable

<PageTitle>Customers - HasapNama</PageTitle>

<AuthorizeView>
	<NotAuthorized>
		<div class="alert alert-warning">
			Please <a href="/login">sign in</a> to view your customers.
		</div>
	</NotAuthorized>
	<Authorized>
		<div class="d-flex justify-content-between align-items-center mb-3">
			<h3 class="mb-0">Customers</h3>
			<button class="btn btn-success" @onclick="StartNew">+ New customer</button>
		</div>

		<div class="mb-3">
			<label class="form-label">Search</label>
			<input class="form-control" placeholder="name, email, phone, company..."
				   value="@query" @onchange="e => OnQuery(e.Value?.ToString())" />
		</div>

		@if (busy)
		{
			<div class="spinner-border text-primary" role="status"></div>
		}
		else if (error is not null)
		{
			<div class="alert alert-danger">@error</div>
		}
		else
		{
			<table class="table table-hover align-middle">
				<thead>
					<tr>
						<th>Name</th>
						<th>Company</th>
						<th>Email</th>
						<th>Phone</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var c in customers)
					{
						<tr>
							<td>@c.Name</td>
							<td>@c.Company</td>
							<td>@c.Email</td>
							<td>@c.Phone</td>
							<td class="text-end">
								<button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(c)">Edit</button>
								<button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c)">Delete</button>
							</td>
						</tr>
					}
					@if (customers.Count == 0)
					{
						<tr><td colspan="5" class="text-muted">No customers yet. Click <em>+ New customer</em> to add one.</td></tr>
					}
				</tbody>
			</table>
		}
	</Authorized>
</AuthorizeView>

@code {
	private List<Customer> customers = new();
	private string? query;
	private bool busy = true;
	private string? errorMSG;

	private async Task OnQuery(string? value)
	{
		query = value;
		await LoadAsync();
	}

	protected override async Task OnInitializedAsync() => await LoadAsync();

	private async Task LoadAsync()
	{
		busy = true;
		errorMSG = null;
		try
		{
			customers = await Api.ListCustomersAsync(query);
		}
		catch (Exception ex)
		{
			errorMSG = ex.Message;
		}
		finally
		{
			busy = false;
		}
	}

	private void StartNew() => Nav.NavigateTo("/customers/new");

	private void Edit(Customer c) => Nav.NavigateTo($"/customers/{c.Id}");

	private async Task Delete(Customer c)
	{
		if (!await Shell.Current.DisplayAlert("Delete customer", $"Delete {c.Name}?", "Delete", "Cancel"))
			return;
		try
		{
			await Api.DeleteCustomerAsync(c.Id);
			await LoadAsync();
		}
		catch (Exception ex)
		{
			errorMSG = ex.Message;
		}
	}

	[Inject] private ApiClient Api { get; set; } = default!;
	[Inject] private NavigationManager Nav { get; set; } = default!;

	public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}